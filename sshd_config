Port 2222
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::
HostKey /etc/personal-remote/ssh_host_rsa_key
PidFile /run/personal-remote-sshd.pid
AuthorizedKeysFile /etc/personal-remote/authorized_keys
StrictModes yes
AllowUsers root
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PubkeyAcceptedAlgorithms rsa-sha2-512,rsa-sha2-256
HostKeyAlgorithms rsa-sha2-512,rsa-sha2-256
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM yes
ForceCommand /usr/bin/python3 -I /usr/local/lib/personal-remote/runner.py
DisableForwarding yes
PermitTTY yes
PermitUserRC no
PermitUserEnvironment no
MaxAuthTries 3
MaxSessions 2
MaxStartups 3:50:10
LoginGraceTime 20
ClientAliveInterval 30
ClientAliveCountMax 3
LogLevel VERBOSE
